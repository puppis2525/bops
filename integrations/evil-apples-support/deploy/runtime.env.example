# Copy to /etc/evil-apples-support/runtime.env; chmod 600 before adding secrets.
# The running user must own this file and /var/lib/evil-apples-support.
# Never commit the populated file, print it, or paste its contents into chat.
WIX_SUPPORT_SITE_ID=
WIX_SUPPORT_AUTH=
# Prefer installed-app OAuth; leave WIX_SUPPORT_AUTH empty when using these.
WIX_SUPPORT_APP_ID=55aba2b0-f6bc-4d8b-98fd-334387fcfe2c
WIX_SUPPORT_APP_SECRET=
SUPPORT_REVIEW_PASSWORD=
SUPPORT_DB=/var/lib/evil-apples-support/queue.sqlite
SUPPORT_PORT=3221
# Enable only after verifying the app's installation belongs to the target site.
WIX_SUPPORT_INSTANCE_ID=
WIX_SUPPORT_PUBLIC_KEY_FILE=/etc/evil-apples-support/wix-webhook-public.pem
# Exact host preserved by a TLS reverse proxy forwarding ONLY /hooks/wix.
SUPPORT_WEBHOOK_HOST=
